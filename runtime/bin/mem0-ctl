#!/usr/bin/env bash
# ==============================================================================
# mem0-ctl — Global CLI Controller for Local Mem0 Ecosystem
#
# Topology:
#   1. Mem0 Host-Native Server  (:11888) — uv run server.py (mem0ai==2.0.19)
#   2. OpenMemory Web UI        (:11889) — Official Frontend Viewer for Mem0
#   3. Qdrant Vector Store      (:6333)  — Vector embeddings storage
#   4. oMLX Local Embedder      (:8898)  — Apple Silicon Metal acceleration
#
# Config Directory: ~/.config/mem0
# ==============================================================================
set -euo pipefail

MEM0_HOME="${MEM0_HOME:-$HOME/.config/mem0}"
MEM0_LAUNCHD_LABEL="${MEM0_LAUNCHD_LABEL:-local.mem0-server}"
MEM0_LAUNCHD_PLIST="${MEM0_LAUNCHD_PLIST:-$HOME/Library/LaunchAgents/$MEM0_LAUNCHD_LABEL.plist}"
launchd_domain="gui/$(id -u)"
launchd_service="$launchd_domain/$MEM0_LAUNCHD_LABEL"

usage() {
    cat << 'HELP'
Usage: mem0-ctl <command> [arguments]

Commands:
  status         Check status of all Mem0 components (API, UI, Qdrant, oMLX)
  start          Start Docker services and the API (requires oMLX running)
  stop           Stop the API and Docker services; keep shared oMLX running
  restart        Restart the API and Docker services; keep shared oMLX running
  health         Query Mem0 API server health endpoint
  logs [-f]      Display or follow Mem0 API server logs
  search <query> Perform semantic search on stored memories
  ui             Display OpenMemory UI URL and relationship information
  help           Show this help message

Aliases available in zsh:
  mem0, mem0-start, mem0-stop, mem0-status, mem0-health, mem0-logs
HELP
}

cmd="${1:-status}"
shift || true

case "$cmd" in
    status)
        echo "=== Local Mem0 Ecosystem Status ==="

        # 1. Mem0 API Server
        printf "  • Mem0 Server     (:11888) : "
        if curl -s -m 2 http://127.0.0.1:11888/health >/dev/null 2>&1; then
            MEM_COUNT=$(curl -s http://127.0.0.1:11888/v1/stats 2>/dev/null | grep -o '"total_memories":[0-9]*' | cut -d: -f2 || echo "?")
            echo "🟢 RUNNING (Host-Native via uv | Memories: ${MEM_COUNT:-?})"
        else
            echo "🔴 DOWN"
        fi

        # 2. OpenMemory UI (Frontend Viewer for Mem0)
        printf "  • OpenMemory UI   (:11889) : "
        if curl -s -m 2 -I http://127.0.0.1:11889 >/dev/null 2>&1; then
            echo "🟢 RUNNING (http://localhost:11889 — Official Mem0 Web UI)"
        else
            echo "🔴 DOWN"
        fi

        # 3. Qdrant Vector DB
        printf "  • Qdrant DB       (:6333)  : "
        if curl -s -m 2 http://127.0.0.1:6333/healthz >/dev/null 2>&1 || curl -s -m 2 http://127.0.0.1:6333/collections >/dev/null 2>&1; then
            echo "🟢 RUNNING (Docker container: mem0-qdrant)"
        else
            echo "🔴 DOWN"
        fi

        # 4. oMLX Local Embeddings
        printf "  • oMLX Embeddings (:8898)  : "
        if curl -s -m 2 http://127.0.0.1:8898/v1/models >/dev/null 2>&1; then
            echo "🟢 RUNNING (Apple Silicon Metal | Qwen3-Embedding-4B)"
        else
            echo "🔴 DOWN (oMLX is not responding)"
        fi
        ;;

    start)
        if [ ! -d "$MEM0_HOME" ]; then
            echo "Error: $MEM0_HOME not found. Install the runtime first." >&2
            exit 1
        fi
        if [ -f "$MEM0_LAUNCHD_PLIST" ]; then
            if launchctl print "$launchd_service" >/dev/null 2>&1; then
                exec launchctl kickstart -k "$launchd_service"
            fi
            exec launchctl bootstrap "$launchd_domain" "$MEM0_LAUNCHD_PLIST"
        fi
        exec "$MEM0_HOME/run.sh" "$@"
        ;;

    stop)
        if [ ! -d "$MEM0_HOME" ]; then
            echo "Error: $MEM0_HOME not found." >&2
            exit 1
        fi
        exec "$MEM0_HOME/stop.sh"
        ;;

    restart)
        echo "Restarting Mem0 stack..."
        "$MEM0_HOME/stop.sh"
        if [ -f "$MEM0_LAUNCHD_PLIST" ]; then
            exec launchctl bootstrap "$launchd_domain" "$MEM0_LAUNCHD_PLIST"
        fi
        exec "$MEM0_HOME/run.sh"
        ;;

    health)
        curl -s http://127.0.0.1:11888/health | jq . || curl -s http://127.0.0.1:11888/health
        ;;

    logs)
        LOG_FILE="$MEM0_HOME/server.log"
        if [ ! -f "$LOG_FILE" ]; then
            echo "No log file found at $LOG_FILE" >&2
            exit 1
        fi
        if [ "${1:-}" = "-f" ] || [ "${1:-}" = "--follow" ]; then
            exec tail -f "$LOG_FILE"
        else
            exec tail -n 50 "$LOG_FILE"
        fi
        ;;

    search)
        if [ $# -eq 0 ]; then
            echo "Usage: mem0-ctl search <query> [user_id]" >&2
            exit 1
        fi
        QUERY="$1"
        USER_ID="${2:-${MEM0_DEFAULT_USER_ID:-local-user}}"
        PAYLOAD=$(jq -n --arg q "$QUERY" --arg u "$USER_ID" '{"query": $q, "user_id": $u}')
        curl -s -X POST http://127.0.0.1:11888/v1/memories/search \
            -H "Content-Type: application/json" \
            -d "$PAYLOAD" | jq '.results[] | {id: .id, score: .score, memory: .memory}'
        ;;

    ui)
        echo "OpenMemory UI (Official Mem0 Frontend Viewer):"
        echo "  URL: http://localhost:11889"
        echo "  Role: Web dashboard visualizing memories stored in Mem0 (:11888)"
        echo "  Auth: None (Direct local access)"
        if command -v open >/dev/null 2>&1 && [ "${1:-}" = "--open" ]; then
            open "http://localhost:11889"
        fi
        ;;

    help|--help|-h)
        usage
        ;;

    *)
        echo "Unknown command: $cmd" >&2
        usage >&2
        exit 1
        ;;
esac
