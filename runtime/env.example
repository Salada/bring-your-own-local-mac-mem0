MEM0_DATA_DIR=__HOME__/.local/share/mem0
MEM0_SERVER_PORT=11888
MEM0_DASHBOARD_PORT=11889
MEM0_DEFAULT_USER_ID=local-user
MEM0_CORS_ORIGINS=http://127.0.0.1:11889,http://localhost:11889
MEM0_TELEMETRY=false
MEM0_ALLOW_UNGUARDED_DELETE=false
QDRANT__TELEMETRY_DISABLED=true
NEXT_TELEMETRY_DISABLED=1

# Required by the default Gemini fact-extraction provider. Set only in the local
# .env file; never commit the populated value.
GOOGLE_API_KEY=

# Optional rclone destination. No remote backup runs unless this is configured
# and mem0-backup is invoked explicitly.
# MEM0_BACKUP_REMOTE=my-remote:/mem0-backups
